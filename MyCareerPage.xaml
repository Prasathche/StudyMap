<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="StudyMap.MyCareerPage"
    BackgroundColor="#F7F7FB"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- ========================================================= -->
        <!-- HEADER -->
        <!-- ========================================================= -->

        <Grid
            Grid.Row="0"
            Padding="20,18,20,10"
            ColumnDefinitions="Auto,*">

            <!-- Back -->
            <ImageButton
                Grid.Column="0"
                Source="arrow_back.png"
                WidthRequest="28"
                HeightRequest="28"
                BackgroundColor="Transparent"
                Clicked="OnBackClicked" />

            <!-- Title -->
            <VerticalStackLayout
                Grid.Column="1"
                Margin="12,0,0,0"
                Spacing="2">

                <Label
                    Text="My Career"
                    FontSize="24"
                    FontAttributes="Bold"
                    TextColor="#222222" />

                <Label
                    Text="Your saved career journey"
                    FontSize="13"
                    TextColor="#777777" />

            </VerticalStackLayout>

        </Grid>


        <!-- ========================================================= -->
        <!-- SUMMARY CARDS -->
        <!-- ========================================================= -->

        <Grid
            Grid.Row="1"
            Padding="20,12"
            ColumnDefinitions="*,*"
            ColumnSpacing="12">

            <!-- Saved Careers -->
            <Border
                Grid.Column="0"
                BackgroundColor="White"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16"
                Padding="16">

                <VerticalStackLayout
                    HorizontalOptions="Center"
                    Spacing="3">

                    <Label
                        x:Name="CareerCountLabel"
                        Text="0"
                        FontSize="26"
                        FontAttributes="Bold"
                        TextColor="#5B3FD3"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Saved Careers"
                        FontSize="12"
                        TextColor="#777777"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

            </Border>


            <!-- Saved Roadmaps -->
            <Border
                Grid.Column="1"
                BackgroundColor="White"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16"
                Padding="16">

                <VerticalStackLayout
                    HorizontalOptions="Center"
                    Spacing="3">

                    <Label
                        x:Name="RoadmapCountLabel"
                        Text="0"
                        FontSize="26"
                        FontAttributes="Bold"
                        TextColor="#5B3FD3"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Saved Roadmaps"
                        FontSize="12"
                        TextColor="#777777"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

            </Border>

        </Grid>


        <!-- ========================================================= -->
        <!-- TABS -->
        <!-- ========================================================= -->

        <Grid
            Grid.Row="2"
            Padding="20,10"
            ColumnDefinitions="*,*">

            <!-- Saved Careers Tab -->
            <Border
                x:Name="CareersTab"
                Grid.Column="0"
                BackgroundColor="#5B3FD3"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 12"
                Margin="0,0,5,0">

                <Label
                    Text="♥  Saved Careers"
                    TextColor="White"
                    FontSize="14"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center"
                    Padding="8" />

                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Tapped="OnCareersTabTapped" />
                </Border.GestureRecognizers>

            </Border>


            <!-- Roadmaps Tab -->
            <Border
                x:Name="RoadmapsTab"
                Grid.Column="1"
                BackgroundColor="White"
                Stroke="#E2E2E8"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Margin="5,0,0,0">

                <Label
                    Text="🗺  Roadmaps"
                    TextColor="#555555"
                    FontSize="14"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center"
                    Padding="8" />

                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Tapped="OnRoadmapsTabTapped" />
                </Border.GestureRecognizers>

            </Border>

        </Grid>


        <!-- ========================================================= -->
        <!-- CONTENT -->
        <!-- ========================================================= -->

        <Grid
            Grid.Row="3"
            Padding="20,5,20,20">


            <!-- ===================================================== -->
            <!-- SAVED CAREERS CONTENT -->
            <!-- ===================================================== -->

            <Grid
                x:Name="SavedCareersSection"
                RowDefinitions="Auto,*">

                <!-- Section Title -->
                <Label
                    Grid.Row="0"
                    Text="Saved Careers"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="#222222"
                    Margin="0,0,0,12" />


                <!-- Saved Careers List -->
                <CollectionView
                    Grid.Row="1"
                    x:Name="SavedCareersCollection"
                    SelectionMode="None">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Border
                                BackgroundColor="White"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 18"
                                Padding="16"
                                Margin="0,0,0,10">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="OnSavedCareerTapped"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>


                                <Grid
                                    ColumnDefinitions="Auto,*,Auto"
                                    ColumnSpacing="12">

                                    <!-- Career Icon -->
                                    <Border
                                        Grid.Column="0"
                                        WidthRequest="48"
                                        HeightRequest="48"
                                        BackgroundColor="#F1EDFF"
                                        StrokeThickness="0">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>

                                        <Label
                                            Text="{Binding Icon}"
                                            FontSize="25"
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center" />

                                    </Border>


                                    <!-- Career Information -->
                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="3"
                                        VerticalOptions="Center">

                                        <Label
                                            Text="{Binding Name}"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            TextColor="#222222"
                                            LineBreakMode="TailTruncation" />

                                        <Label
                                            Text="{Binding Category}"
                                            FontSize="12"
                                            TextColor="#5B3FD3" />

                                        <Label
                                            Text="{Binding Description}"
                                            FontSize="12"
                                            TextColor="#777777"
                                            MaxLines="2"
                                            LineBreakMode="TailTruncation" />

                                    </VerticalStackLayout>


                                    <!-- Arrow -->
                                   <!-- Remove Saved Career -->
<Button
    Grid.Column="2"
    Text="🗑"
    FontSize="18"
    BackgroundColor="Transparent"
    TextColor="#C62828"
    WidthRequest="44"
    HeightRequest="44"
    Padding="0"
    Clicked="OnRemoveSavedCareerClicked"
    CommandParameter="{Binding .}"
    VerticalOptions="Center" />

                                </Grid>

                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>


                <!-- Empty State -->
                <Border
                    x:Name="SavedCareersEmptyState"
                    Grid.Row="1"
                    BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 18"
                    Padding="25"
                    IsVisible="False">

                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="8">

                        <Label
                            Text="♥"
                            FontSize="42"
                            TextColor="#5B3FD3"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Your saved careers will appear here"
                            FontSize="14"
                            TextColor="#777777"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Tap the heart on a career to save it."
                            FontSize="12"
                            TextColor="#999999"
                            HorizontalTextAlignment="Center" />

                        <Button
                            Text="Explore Careers"
                            BackgroundColor="#5B3FD3"
                            TextColor="White"
                            CornerRadius="20"
                            HeightRequest="44"
                            Margin="0,8,0,0"
                            Clicked="OnExploreClicked" />

                    </VerticalStackLayout>

                </Border>

            </Grid>


            <!-- ===================================================== -->
            <!-- ROADMAPS CONTENT -->
            <!-- ===================================================== -->

            <Grid
                x:Name="RoadmapsSection"
                IsVisible="False"
                RowDefinitions="Auto,*">

                <!-- Section Title -->
                <Label
                    Grid.Row="0"
                    Text="My Roadmaps"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="#222222"
                    Margin="0,0,0,12" />


                <!-- Roadmap Empty State -->
                <Border
                    Grid.Row="1"
                    BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 18"
                    Padding="25">

                    <VerticalStackLayout
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="8">

                        <Label
                            Text="🗺"
                            FontSize="42"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Your saved roadmaps will appear here"
                            FontSize="14"
                            TextColor="#777777"
                            HorizontalTextAlignment="Center" />

                        <Label
                            Text="Roadmaps you save will appear here."
                            FontSize="12"
                            TextColor="#999999"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</ContentPage>