<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudyMap.CareerResultsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F0F4FF">

    <ContentPage.Resources>
        <Color x:Key="Ink">#17203B</Color>
        <Color x:Key="Muted">#7D849A</Color>
        <Color x:Key="Surface">#FFFFFF</Color>
        <Color x:Key="SoftBorder">#EEF0F6</Color>
        <Color x:Key="Accent">#7C57F5</Color>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
            <Setter Property="Padding" Value="18" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*">

        <Border Grid.Row="0" StrokeThickness="0" Padding="20,52,20,24">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#EDE7FF" Offset="0.0" />
                    <GradientStop Color="#F3E5F5" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.Column="2" BackgroundColor="{StaticResource Surface}" WidthRequest="42" HeightRequest="42" StrokeThickness="0" VerticalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="21" /></Border.StrokeShape>
                        <Label Text="⌂" FontSize="24" FontAttributes="Bold" TextColor="#7C57F5" HorizontalOptions="Center" VerticalOptions="Center" />
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnHomeTapped" /></Border.GestureRecognizers>
                    </Border>
                    <ImageButton Source="arrow_back.png" WidthRequest="28" HeightRequest="28" BackgroundColor="Transparent" Clicked="OnBackTapped" VerticalOptions="Center" />
                </Grid>
                <VerticalStackLayout Grid.Row="1" Spacing="6">
                    <Label Text="Careers You Could Explore" FontFamily="OpenSansSemibold" FontSize="24" TextColor="{StaticResource Ink}" LineBreakMode="WordWrap" />
                    <Label Text="Based on your interests and strengths" FontSize="14" TextColor="{StaticResource Muted}" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20,18,20,32" Spacing="16">

                <!-- Important Disclaimer -->
                <Border BackgroundColor="#FFF8E8" Stroke="#F3C46B" StrokeThickness="1" Padding="14,12">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Grid.Column="0" BackgroundColor="#F57C00" WidthRequest="34" HeightRequest="34" Padding="0" VerticalOptions="Start">
                            <Border.StrokeShape><RoundRectangle CornerRadius="17" /></Border.StrokeShape>
                            <Label Text="i" FontFamily="OpenSansSemibold" FontSize="19" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Important Note" FontFamily="OpenSansSemibold" FontSize="14" TextColor="#8A4B08" />
                            <Label Text="These recommendations are for educational and career-exploration purposes only. They are based on your answers and are intended to help you explore possibilities, not to provide a definitive career assessment. Interests and strengths can change over time. Please verify important education and career details with official sources before making decisions." FontSize="12.5" TextColor="#6F6048" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border x:Name="NoMatchBanner" Style="{StaticResource SectionCard}" IsVisible="False">
                    <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="#08000000" Offset="0,4" Radius="12" Opacity="1" /></Border.Shadow>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="🔎 We couldn't find a strong match yet." FontFamily="OpenSansSemibold" FontSize="15" TextColor="{StaticResource Ink}" />
                        <Label Text="Try exploring these career areas to get started." FontSize="13" TextColor="{StaticResource Muted}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout x:Name="ResultsLayout" Spacing="14" />

                <Border Style="{StaticResource SectionCard}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="#08000000" Offset="0,4" Radius="12" Opacity="1" /></Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Want to explore more?" FontFamily="OpenSansSemibold" FontSize="16" TextColor="{StaticResource Ink}" />
                        <Button x:Name="ViewAllMatchesButton" Text="View All Matches" BackgroundColor="{StaticResource Accent}" TextColor="White" FontFamily="OpenSansSemibold" FontSize="14" CornerRadius="14" HeightRequest="48" Clicked="OnViewAllMatchesClicked" />
                        <Button Text="Explore Careers" BackgroundColor="#F0F0FA" TextColor="{StaticResource Ink}" FontFamily="OpenSansSemibold" FontSize="14" CornerRadius="14" HeightRequest="48" Clicked="OnExploreCareersClicked" />
                        <Button Text="Reset &amp; Start Again" BackgroundColor="Transparent" TextColor="{StaticResource Accent}" FontFamily="OpenSansSemibold" FontSize="14" CornerRadius="14" HeightRequest="48" Clicked="OnRetakeClicked" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource SectionCard}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="#08000000" Offset="0,4" Radius="12" Opacity="1" /></Border.Shadow>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="👨‍👩‍👧 For Parents" FontFamily="OpenSansSemibold" FontSize="15" TextColor="{StaticResource Ink}" />
                        <Label Text="These recommendations are a starting point for exploration. A student's interests can change over time. Consider subjects, aptitude, academic performance, personality, and professional guidance before making major education decisions." FontSize="13" TextColor="{StaticResource Muted}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
