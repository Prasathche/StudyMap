<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudyMap.CareerComparisonPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F0F4FF">

    <ContentPage.Resources>
        <Color x:Key="Ink">#17203B</Color>
        <Color x:Key="Muted">#7D849A</Color>
        <Color x:Key="Surface">#FFFFFF</Color>
        <Color x:Key="SoftBorder">#EEF0F6</Color>
        <Color x:Key="Accent">#2E7D6B</Color>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Padding="20,44,20,14" Spacing="10">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <ImageButton Source="arrow_back.png"
                             WidthRequest="32"
                             HeightRequest="32"
                             Padding="4"
                             BackgroundColor="Transparent"
                             Clicked="OnBackTapped"
                             VerticalOptions="Center" />

                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="Compare Careers"
                           FontFamily="OpenSansSemibold"
                           FontSize="24"
                           TextColor="{StaticResource Ink}" />
                    <Label Text="Compare the factors that matter most"
                           FontSize="12"
                           TextColor="{StaticResource Muted}" />
                </VerticalStackLayout>

                <Border Grid.Column="2"
                        BackgroundColor="White"
                        WidthRequest="42"
                        HeightRequest="42"
                        StrokeThickness="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="21" /></Border.StrokeShape>
                    <Label Text="⌂"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#7C57F5"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHomeTapped" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>
        </VerticalStackLayout>

        <!-- Mobile-friendly vertical comparison -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20,0,20,32" Spacing="14">

                <Border BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="16">
                    <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="#08000000" Offset="0,3" Radius="10" Opacity="1" /></Border.Shadow>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Your selected careers"
                               FontFamily="OpenSansSemibold"
                               FontSize="14"
                               TextColor="{StaticResource Ink}" />
                        <Label Text="Review each factor below. The comparison is informational and does not rank careers."
                               FontSize="12"
                               TextColor="{StaticResource Muted}"
                               LineBreakMode="WordWrap" />
                        <FlexLayout x:Name="SelectedCareersLayout"
                                    Direction="Row"
                                    Wrap="Wrap"
                                    AlignItems="Start"
                                    JustifyContent="Start"
                                    Margin="0,6,0,0" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout x:Name="ComparisonContent" Spacing="12" />

                <Label Text="Career information is intended for exploration and general guidance. Salary, demand, stability and opportunities can vary by location, employer, experience, skills and economic conditions."
                       FontSize="11"
                       TextColor="{StaticResource Muted}"
                       LineBreakMode="WordWrap"
                       Margin="0,4,0,0" />

                <Button Text="← Back to Decide"
                        BackgroundColor="White"
                        TextColor="{StaticResource Accent}"
                        BorderColor="{StaticResource Accent}"
                        BorderWidth="1"
                        CornerRadius="14"
                        Padding="18,10"
                        HorizontalOptions="Fill"
                        Clicked="OnBackToDecideTapped" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
