<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudyMap.CareerQuestionPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F0F4FF">

    <ContentPage.Resources>
        <Color x:Key="Ink">#17203B</Color>
        <Color x:Key="Muted">#7D849A</Color>
        <Color x:Key="Surface">#FFFFFF</Color>
        <Color x:Key="SoftBorder">#EEF0F6</Color>
        <Color x:Key="Accent">#7C57F5</Color>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header: back + progress -->
        <VerticalStackLayout Grid.Row="0" Padding="20,52,20,12" Spacing="14">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border BackgroundColor="{StaticResource Surface}"
                        WidthRequest="42" HeightRequest="42" StrokeThickness="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="21" /></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="#12000000" Offset="0,3" Radius="8" Opacity="1" /></Border.Shadow>
                    <ImageButton
                        Source="arrow_back.png"
                        WidthRequest="28"
                        HeightRequest="28"
                        BackgroundColor="Transparent"
                        Clicked="OnBackTapped"
                        VerticalOptions="Center" />

                <Label x:Name="QuestionCounterLabel"
                       Grid.Column="1"
                       FontFamily="OpenSansSemibold" FontSize="15"
                       TextColor="{StaticResource Muted}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>

            <ProgressBar x:Name="ProgressBarControl"
                         ProgressColor="{StaticResource Accent}"
                         HeightRequest="8" />
        </VerticalStackLayout>

        <!-- Question + options -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20,10,20,24" Spacing="18">

                <Label x:Name="QuestionTextLabel"
                       FontFamily="OpenSansSemibold" FontSize="24"
                       TextColor="{StaticResource Ink}"
                       LineBreakMode="WordWrap" />

                <Label x:Name="HintLabel"
                       Text="Select all that apply"
                       FontSize="13" TextColor="{StaticResource Muted}" />

                <VerticalStackLayout x:Name="OptionsLayout" Spacing="12" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Next button -->
        <VerticalStackLayout Grid.Row="2" Padding="20,0,20,28" Spacing="10">
            <Button x:Name="NextButton"
                    Text="Next"
                    BackgroundColor="{StaticResource Accent}"
                    TextColor="White"
                    FontFamily="OpenSansSemibold" FontSize="16"
                    CornerRadius="16" HeightRequest="54"
                    IsEnabled="False"
                    Opacity="0.5"
                    Clicked="OnNextClicked">
                <Button.Shadow><Shadow Brush="#307C57F5" Offset="0,8" Radius="16" Opacity="1" /></Button.Shadow>
            </Button>
        </VerticalStackLayout>

    </Grid>

</ContentPage>
