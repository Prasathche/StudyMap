<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StudyMap.CareerDiscoveryPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F0F4FF">

    <ContentPage.Resources>
        <Color x:Key="Ink">#17203B</Color>
        <Color x:Key="Muted">#7D849A</Color>
        <Color x:Key="Surface">#FFFFFF</Color>
        <Color x:Key="SoftBorder">#EEF0F6</Color>
    </ContentPage.Resources>

    <Grid RowDefinitions="*">

        <!-- Body -->
        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="24,52,24,32" Spacing="22">

                <!-- Illustration -->
                <Border StrokeThickness="0" HeightRequest="140" WidthRequest="140"
                        HorizontalOptions="Center" Margin="0,10,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#7C57F5" Offset="0.0" />
                            <GradientStop Color="#A78BFA" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.StrokeShape><RoundRectangle CornerRadius="70" /></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="#307C57F5" Offset="0,12" Radius="24" Opacity="1" /></Border.Shadow>
                    <Label Text="&#129517;" FontSize="64" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <!-- Title -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Not Sure What to Choose?"
                           FontFamily="OpenSansSemibold" FontSize="26"
                           TextColor="{StaticResource Ink}"
                           HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                    <Label Text="Let's discover careers that match your interests and strengths."
                           FontSize="15" TextColor="{StaticResource Muted}"
                           HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <!-- Info card -->
                <Border StrokeThickness="0" Padding="20" BackgroundColor="{StaticResource Surface}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="#08000000" Offset="0,4" Radius="12" Opacity="1" /></Border.Shadow>
                    <VerticalStackLayout Spacing="14">

                        <HorizontalStackLayout Spacing="12">
                            <Label Text="&#9201;" FontSize="20" />
                            <Label Text="Takes about 2 minutes" FontSize="14"
                                   TextColor="{StaticResource Ink}" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="12">
                            <Label Text="&#9989;" FontSize="20" />
                            <Label Text="There are no right or wrong answers" FontSize="14"
                                   TextColor="{StaticResource Ink}" VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="12">
                            <Label Text="&#128161;" FontSize="20" />
                            <Label Text="Your answers help us suggest careers to explore" FontSize="14"
                                   TextColor="{StaticResource Ink}" VerticalOptions="Center"
                                   LineBreakMode="WordWrap" />
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- CTA -->
                <Button Text="Let's Get Started"
                        BackgroundColor="#7C57F5"
                        TextColor="White"
                        FontFamily="OpenSansSemibold" FontSize="16"
                        CornerRadius="16" HeightRequest="54"
                        Clicked="OnGetStartedClicked">
                    <Button.Shadow><Shadow Brush="#307C57F5" Offset="0,8" Radius="16" Opacity="1" /></Button.Shadow>
                </Button>

                <Button Text="Maybe Later"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Muted}"
                        FontFamily="OpenSansSemibold" FontSize="14"
                        CornerRadius="16" HeightRequest="44"
                        Clicked="OnMaybeLaterClicked" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
