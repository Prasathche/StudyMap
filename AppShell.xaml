<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="StudyMap.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:StudyMap"
    Shell.FlyoutBehavior="Disabled"
    Title="StudyMap"
    BackgroundColor="#F0F4FF">

    <Shell.Resources>
        <Style x:Key="BaseStyle" TargetType="Element">
            <Setter Property="Shell.BackgroundColor" Value="#F0F4FF" />
            <Setter Property="Shell.ForegroundColor" Value="#17203B" />
            <Setter Property="Shell.TitleColor" Value="#17203B" />
            <Setter Property="Shell.DisabledColor" Value="#A0A0A0" />
            <Setter Property="Shell.UnselectedColor" Value="#949494" />
        </Style>
        <Style TargetType="TabBar" BasedOn="{StaticResource BaseStyle}">
            <Setter Property="Shell.TabBarBackgroundColor" Value="#FFFFFF" />
            <Setter Property="Shell.TabBarForegroundColor" Value="#7C57F5" />
            <Setter Property="Shell.TabBarUnselectedColor" Value="#6F7180" />
            <Setter Property="Shell.TabBarTitleColor" Value="#7C57F5" />
        </Style>
    </Shell.Resources>

    <TabBar>
        <!-- Tab 1: Discover all careers -->
        <ShellContent
            Title="Explore"
            Icon="home.png"
            ContentTemplate="{DataTemplate local:CareerExplorerPage}"
            Route="CareerExplorerPage" />

        <!-- Tab 2: Stream-Based Career Module -->
        <ShellContent
            Title="Filter"
            Icon="navigation.png"
            ContentTemplate="{DataTemplate local:StreamSelectionPage}"
            Route="StreamSelectionPage" />

        <!-- Tab 3: Roadmap -->
        <ShellContent
            Title="Plan"
            Icon="navigation.png"
            ContentTemplate="{DataTemplate local:CareerRoadmapPage}"
            Route="CareerRoadmapPage" />

        <!-- Tab 4: Not Sure What to Choose -->
        <ShellContent
            Title="Discover"
            Icon="navigation.png"
            ContentTemplate="{DataTemplate local:CareerDiscoveryPage}"
            Route="CareerDiscoveryPage" />

        <!-- Tab 5: Parent Insights -->
        <ShellContent
            Title="Decide"
            Icon="navigation.png"
            ContentTemplate="{DataTemplate local:ParentInsightsPage}"
            Route="ParentInsightsPage" />
    </TabBar>

</Shell>