<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StudyMap.ViewModels"
             x:Class="StudyMap.StreamSelectionPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F0F4FF">

    <ContentPage.Resources>
        <Color x:Key="Ink">#17203B</Color>
        <Color x:Key="Muted">#7D849A</Color>
        <Color x:Key="Surface">#FFFFFF</Color>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- Hero Header -->
        <Border Grid.Row="0" StrokeThickness="0" Padding="24,56,24,24">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#E8F1FF" Offset="0.0" />
                    <GradientStop Color="#F3E5F5" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Choose Your Stream"
                           FontFamily="OpenSansSemibold" FontSize="26"
                           TextColor="{StaticResource Ink}" LineBreakMode="WordWrap" />
                    <Label Text="Select your academic path to explore matching careers"
                           FontSize="14" TextColor="{StaticResource Muted}" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
                <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="#33FFFFFF"
                        Padding="14" VerticalOptions="Center">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <Label Text="&#127919;" FontSize="34" HorizontalTextAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- Scrollable Cards -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20,16,20,40" Spacing="18">

                <!-- Section Label -->
                <Label Text="Pick a stream to explore careers"
                       FontFamily="OpenSansSemibold" FontSize="16"
                       TextColor="{StaticResource Ink}" />

                <!-- SCIENCE CARD -->
                <Border x:Name="scienceCard" StrokeThickness="0" Padding="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="#18000000" Offset="0,8" Radius="24" Opacity="1" /></Border.Shadow>
                    <Grid RowDefinitions="Auto,Auto,Auto">
                        <!-- Gradient banner -->
                        <Border Grid.Row="0" StrokeThickness="0" HeightRequest="110" Padding="22,20,22,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2979FF" Offset="0.0" />
                                    <GradientStop Color="#64B5F6" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                    <Label Text="&#128300; Science" FontFamily="OpenSansSemibold"
                                           FontSize="22" TextColor="White" />
                                    <Label Text="For curious minds who love to experiment"
                                           FontSize="12" TextColor="#CCE5FF" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="&#128300;" FontSize="54"
                                       Opacity="0.25" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <!-- White body -->
                        <VerticalStackLayout Grid.Row="1" BackgroundColor="{StaticResource Surface}"
                                             Padding="22,16,22,4" Spacing="10">
                            <Label Text="Explore technology, healthcare, engineering &amp; research careers."
                                   FontSize="13" TextColor="{StaticResource Muted}" LineBreakMode="WordWrap" />
                            <!-- Featured careers chips -->
                            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start">
                                <Border StrokeThickness="0" BackgroundColor="#DCEEFF"
                                        Padding="10,4" Margin="0,0,6,6">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                    <Label Text="&#128187; Software Engineer" FontSize="11" TextColor="#1A56C6" />
                                </Border>
                                <Border StrokeThickness="0" BackgroundColor="#DCEEFF"
                                        Padding="10,4" Margin="0,0,6,6">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                    <Label Text="&#129658; Doctor" FontSize="11" TextColor="#1A56C6" />
                                </Border>
                                <Border StrokeThickness="0" BackgroundColor="#DCEEFF"
                                        Padding="10,4" Margin="0,0,6,6">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                    <Label Text="&#128202; Data Scientist" FontSize="11" TextColor="#1A56C6" />
                                </Border>
                            </FlexLayout>
                        </VerticalStackLayout>
                        <!-- CTA row -->
                        <Grid Grid.Row="2" BackgroundColor="{StaticResource Surface}"
                              ColumnDefinitions="*,Auto" Padding="22,0,22,20">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label x:Name="ScienceCountLabel" Text="15+ Careers Available"
                                       FontFamily="OpenSansSemibold" FontSize="13" TextColor="#2979FF" />
                                <Label Text="High salary &#128200; • Very High Demand"
                                       FontSize="11" TextColor="{StaticResource Muted}" />
                            </VerticalStackLayout>
                            <Button Text="Explore Careers  &#8594;" BackgroundColor="#2979FF"
                                    TextColor="White" CornerRadius="14" Padding="18,12"
                                    FontFamily="OpenSansSemibold" FontSize="13"
                                    VerticalOptions="Center"
                                    Clicked="OnScienceClicked" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- COMMERCE CARD -->
                <Border x:Name="commerceCard" StrokeThickness="0" Padding="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="#18000000" Offset="0,8" Radius="24" Opacity="1" /></Border.Shadow>
                    <Grid RowDefinitions="Auto,Auto,Auto">
                        <Border Grid.Row="0" StrokeThickness="0" HeightRequest="110" Padding="22,20,22,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#00897B" Offset="0.0" />
                                    <GradientStop Color="#4DB6AC" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                    <Label Text="&#128200; Commerce" FontFamily="OpenSansSemibold"
                                           FontSize="22" TextColor="White" />
                                    <Label Text="For leaders who understand markets &amp; money"
                                           FontSize="12" TextColor="#C8F0EC" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="&#128200;" FontSize="54"
                                       Opacity="0.25" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <VerticalStackLayout Grid.Row="1" BackgroundColor="{StaticResource Surface}"
                                             Padding="22,16,22,4" Spacing="10">
                            <Label Text="Discover careers in business, finance, accounting &amp; management."
                                   FontSize="13" TextColor="{StaticResource Muted}" LineBreakMode="WordWrap" />
                            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start">
                                <Border StrokeThickness="0" BackgroundColor="#D0F0EB"
                                        Padding="10,4" Margin="0,0,6,6">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                    <Label Text="&#129534; Chartered Accountant" FontSize="11" TextColor="#00695C" />
                                </Border>
                                <Border StrokeThickness="0" BackgroundColor="#D0F0EB"
                                        Padding="10,4" Margin="0,0,6,6">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                    <Label Text="&#128185; Investment Banker" FontSize="11" TextColor="#00695C" />
                                </Border>
                                <Border StrokeThickness="0" BackgroundColor="#D0F0EB"
                                        Padding="10,4" Margin="0,0,6,6">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                    <Label Text="&#128221; Business Analyst" FontSize="11" TextColor="#00695C" />
                                </Border>
                            </FlexLayout>
                        </VerticalStackLayout>
                        <Grid Grid.Row="2" BackgroundColor="{StaticResource Surface}"
                              ColumnDefinitions="*,Auto" Padding="22,0,22,20">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label x:Name="CommerceCountLabel" Text="10+ Careers Available"
                                       FontFamily="OpenSansSemibold" FontSize="13" TextColor="#00897B" />
                                <Label Text="High salary &#128200; • High Demand"
                                       FontSize="11" TextColor="{StaticResource Muted}" />
                            </VerticalStackLayout>
                            <Button Text="Explore Careers  &#8594;" BackgroundColor="#00897B"
                                    TextColor="White" CornerRadius="14" Padding="18,12"
                                    FontFamily="OpenSansSemibold" FontSize="13"
                                    VerticalOptions="Center"
                                    Clicked="OnCommerceClicked" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- ARTS CARD -->
                <Border x:Name="artsCard" StrokeThickness="0" Padding="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="#18000000" Offset="0,8" Radius="24" Opacity="1" /></Border.Shadow>
                    <Grid RowDefinitions="Auto,Auto,Auto">
                        <Border Grid.Row="0" StrokeThickness="0" HeightRequest="110" Padding="22,20,22,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#7B1FA2" Offset="0.0" />
                                    <GradientStop Color="#BA68C8" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                    <Label Text="&#127912; Arts" FontFamily="OpenSansSemibold"
                                           FontSize="22" TextColor="White" />
                                    <Label Text="For creative souls who shape culture"
                                           FontSize="12" TextColor="#E8C7F5" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1" Text="&#127912;" FontSize="54"
                                       Opacity="0.25" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <VerticalStackLayout Grid.Row="1" BackgroundColor="{StaticResource Surface}"
                                             Padding="22,16,22,4" Spacing="10">
                            <Label Text="Uncover careers in design, law, media, social sciences &amp; humanities."
                                   FontSize="13" TextColor="{StaticResource Muted}" LineBreakMode="WordWrap" />
                            <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start">
                                <Border StrokeThickness="0" BackgroundColor="#EDD5F7"
                                        Padding="10,4" Margin="0,0,6,6">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                    <Label Text="&#9878; Lawyer" FontSize="11" TextColor="#6A1B9A" />
                                </Border>
                                <Border StrokeThickness="0" BackgroundColor="#EDD5F7"
                                        Padding="10,4" Margin="0,0,6,6">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                    <Label Text="&#128241; UI/UX Designer" FontSize="11" TextColor="#6A1B9A" />
                                </Border>
                                <Border StrokeThickness="0" BackgroundColor="#EDD5F7"
                                        Padding="10,4" Margin="0,0,6,6">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                    <Label Text="&#129504; Psychologist" FontSize="11" TextColor="#6A1B9A" />
                                </Border>
                            </FlexLayout>
                        </VerticalStackLayout>
                        <Grid Grid.Row="2" BackgroundColor="{StaticResource Surface}"
                              ColumnDefinitions="*,Auto" Padding="22,0,22,20">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label x:Name="ArtsCountLabel" Text="12+ Careers Available"
                                       FontFamily="OpenSansSemibold" FontSize="13" TextColor="#7B1FA2" />
                                <Label Text="Creative paths &#127912; • Growing Demand"
                                       FontSize="11" TextColor="{StaticResource Muted}" />
                            </VerticalStackLayout>
                            <Button Text="Explore Careers  &#8594;" BackgroundColor="#7B1FA2"
                                    TextColor="White" CornerRadius="14" Padding="18,12"
                                    FontFamily="OpenSansSemibold" FontSize="13"
                                    VerticalOptions="Center"
                                    Clicked="OnArtsClicked" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Did You Know Info Card -->
                <Border StrokeThickness="0" Padding="18" BackgroundColor="{StaticResource Surface}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="#08000000" Offset="0,4" Radius="12" Opacity="1" /></Border.Shadow>
                    <HorizontalStackLayout Spacing="14">
                        <Border StrokeThickness="0" BackgroundColor="#FFF9E7" Padding="12"
                                VerticalOptions="Start">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <Label Text="&#128161;" FontSize="24" />
                        </Border>
                        <VerticalStackLayout Spacing="4" HorizontalOptions="FillAndExpand">
                            <Label Text="Did you know?" FontFamily="OpenSansSemibold"
                                   FontSize="15" TextColor="{StaticResource Ink}" />
                            <Label Text="The right stream is the launchpad for your dream career. Take your time exploring each option!"
                                   FontSize="13" TextColor="{StaticResource Muted}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>

                <!-- Not Sure What to Choose CTA -->
                <Border x:Name="notSureCard" StrokeThickness="0" Padding="20">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="#207C57F5" Offset="0,8" Radius="18" Opacity="1" /></Border.Shadow>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#7C57F5" Offset="0.0" />
                            <GradientStop Color="#A78BFA" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border StrokeThickness="0" BackgroundColor="#33FFFFFF" Padding="12"
                                VerticalOptions="Center">
                            <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                            <Label Text="&#129517;" FontSize="26" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="Not sure which stream fits you?" FontFamily="OpenSansSemibold"
                                   FontSize="15" TextColor="White" LineBreakMode="WordWrap" />
                            <Label Text="Take a short 2-minute quiz to discover careers that match your interests."
                                   FontSize="12" TextColor="#E8E0FF" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNotSureTapped" />
                    </Border.GestureRecognizers>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>