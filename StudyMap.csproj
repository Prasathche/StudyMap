<Project Sdk="Microsoft.NET.Sdk">
<!--

👉 Start with 5 modules only:

Career Explorer
Career Roadmap ⭐
Stream-Based Careers
Not Sure Guide
Parent Insights
⚡ Future Modules (Phase 2)

Don’t build now, but plan:

🎓 College recommendations
🧑‍🏫 Counselor connect
📊 Salary trends (real data)
🤖 AI chat assistant
🎯 1. Career Explorer
📌 Description

Explore a wide range of career options with simple and easy-to-understand information.

💡 What it does
Lets students browse and search careers
Provides a quick overview of each career
📊 Includes
Career description
Key responsibilities
Required skills
Salary range
Future demand
👥 Who it helps
Students who want to explore possibilities
Parents who want to understand different careers
🧭 2. Career Roadmap ⭐ (Core Feature)
📌 Description

Provides a step-by-step path showing exactly what a student should do to achieve a specific career.

💡 What it does
Breaks down the journey from school to career
Gives clear direction at every stage
📊 Includes
Class 10 → Stream selection
Class 11–12 → Subjects
Entchoicerance exams
Undergraduate courses
Optional postgraduate paths
👥 Who it helps
Students who have a goal but don’t know the path
Parents looking for structured guidance
🔄 3. Stream-Based Career Options
📌 Description

Shows career options available based on the student’s chosen stream.

💡 What it does
Helps students understand opportunities within:
Science
Commerce
Arts
📊 Includes
List of careers per stream
Quick navigation to career details
👥 Who it helps
Students who already selected a stream
Students confused about stream 
🤔 4. “Not Sure What to Choose”
📌 Description

Guides students to suitable careers based on their interests and strengths.

💡 What it does
Asks simple questions like:
Do you like Math?
Are you creative?
Do you enjoy helping people?
📊 Includes
Interest-based suggestions
Recommended careers
👥 Who it helps
Students who are confused
Early-stage decision makers (Class 8–10)
👨‍👩‍👧 5. Parent Insights ⭐
📌 Description

Provides simple and practical insights to help parents make informed decisions about their child’s career.

💡 What it does
Translates complex career data into easy insights
📊 Includes
Salary range in India
Job stability (Safe / Risky)
Difficulty level
Future demand
👥 Who it helps
Parents who guide decisions
Families evaluating career risks
🧠 Final Positioning (Very Important)

Together, these modules ensure your app:

✅ Explores options
✅ Guides decisions
✅ Provides clear direction

🚀 One-Line Summary of Modules
Explore → Career Explorer
Plan → Career Roadmap
Filter → Stream-Based Careers
Discover → Not Sure Guide
Decide → Parent Insights
-->
	<PropertyGroup>
		<TargetFrameworks>net8.0-android;net8.0-ios;net8.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net8.0-windows10.0.19041.0</TargetFrameworks>
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net8.0-tizen</TargetFrameworks> -->

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>StudyMap</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>StudyMap</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.studymap</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">11.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">13.1</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)' == 'Debug|net8.0-android'">
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#F6F7FB" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
	</ItemGroup>

</Project>
